# ── Port binding ────────────────────────────────────────────────────────
# Bind all published ports (8420/8125/8424) to this IP ONLY — set it to your
# VPS's NetBird mesh IP (check with: netbird status) so nothing is reachable
# from the public internet. Empty = all interfaces (0.0.0.0).
TDAI_BIND_IP=

# ── Gateway auth (Bearer gate) ────────────────────────────────────────────
# Your pi extension sends `Authorization: Bearer <this>` on every request.
# On a VPS this MUST be a long random value — generate one with:
#   openssl rand -hex 32
# (The official full-stack deploy leaves this empty for proxy compatibility,
#  but the pi extension talks to memory-core DIRECTLY, so Bearer auth works
#  fine here — turn it on.)
TDAI_GATEWAY_API_KEY=REPLACE_WITH_LONG_RANDOM_HEX

# ── LLM for memory extraction (L1/L2/L3 pipeline) ────────────────────────
# Any OpenAI-compatible endpoint works (DeepSeek, OpenRouter, SiliconFlow, ...).
TDAI_LLM_BASE_URL=https://api.deepseek.com/v1
TDAI_LLM_API_KEY=REPLACE_ME
TDAI_LLM_MODEL=deepseek-chat
